{
  "name": "@lecture-companion/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:contract": "vitest run tests/backend-contract.test.ts",
    "test:browser": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@lecture-companion/contracts": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
