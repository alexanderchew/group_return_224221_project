{
  "name": "lecture-companion",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:browser": "npm run test:browser --workspace apps/web",
    "mobile": "npm run start --workspace apps/mobile",
    "typecheck:mobile": "npm run typecheck --workspace apps/mobile",
    "export:mobile": "npm run export --workspace apps/mobile"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
